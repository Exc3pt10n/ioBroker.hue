{
  "name": "iobroker.hue-v2",
  "version": "4.0.1",
  "description": "Connects Philips Hue lights, sensors, switches, rooms, zones and scenes via the Hue Bridge API v2",
  "author": "hobbyquaker <hq@ccu.io>",
  "contributors": [
    "hobbyquaker <hq@ccu.io>",
    "Pmant <patrickmo@gmx.de>",
    "Bluefox <dogafox@gmail.com>",
    "Moritz Heusinger <moritz.heusinger@gmail.com>",
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "https://github.com/Exc3pt10n/ioBroker.hue-v2",
  "license": "Apache-2.0",
  "keywords": [
    "ioBroker",
    "hue",
    "philips hue",
    "led",
    "rgb",
    "zigbee",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Exc3pt10n/ioBroker.hue-v2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@iobroker/types": "^7.2.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^4.3.10",
    "mocha": "^11.8.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "npm run build:ts",
    "prepare": "npm run build",
    "check": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs .",
    "test:unit": "mocha -r ts-node/register \"test/unit/**/*.test.ts\" --exit",
    "test:package": "mocha -r ts-node/register test/packageFiles.ts --exit",
    "test:integration": "mocha -r ts-node/register test/integrationAdapter.ts --exit",
    "test": "npm run test:unit && npm run test:package",
    "translate": "translate-adapter"
  },
  "bugs": {
    "url": "https://github.com/Exc3pt10n/ioBroker.hue-v2/issues"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ]
}
